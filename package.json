{
  "name": "signal-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "npm run build:web && npm run build:go",
    "build:web": "vite build",
    "build:go": "go mod download && go build -trimpath -o bin/ ./src/cmd/...",
    "local": "npm run build && ./bin/signal-atlas",
    "docker": "docker compose up --build -d --wait",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "^1.45.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "license": "MIT",
  "author": "Michael Kozicki",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjkozicki/signal-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/mjkozicki/signal-atlas/issues"
  },
  "homepage": "https://mjkozicki.github.io/signal-atlas/",
  "description": "Local Wi-Fi, Bluetooth Low Energy, and NFC discovery with an embedded dashboard.",
  "engines": {
    "node": ">=22.12.0"
  }
}

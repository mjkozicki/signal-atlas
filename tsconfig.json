{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "node"
    ]
  },
  "include": [
    "src/web/src/**/*.ts",
    "src/web/src/**/*.svelte",
    "vite.config.ts"
  ]
}
